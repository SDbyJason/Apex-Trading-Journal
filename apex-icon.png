<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f0d074"/>
      <stop offset="0.5" stop-color="#e0b84c"/>
      <stop offset="1" stop-color="#b8922f"/>
    </linearGradient>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#14161c"/>
      <stop offset="1" stop-color="#080a0e"/>
    </linearGradient>
  </defs>
  <!-- full-bleed background keeps the mark safe under maskable cropping -->
  <rect width="512" height="512" fill="url(#bg)"/>
